# Kopirati u .env pre pokretanja: cp .env.example .env

# MySQL (db servis)
# Lozinka mora biti root, jer je backend ima upisanu u application.properties
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=web_shop

# Backend: adresa baze, "db" je ime MySQL servisa u docker-compose.yaml
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/web_shop?useSSL=false
